body {
    font-family: 'Arial', sans-serif;
    line-height: 1.6;
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
    color: #333;
}

.container {
    width: 80%;
    max-width: 960px;
    margin: 20px auto;
    background: #fff;
    padding: 20px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

header {
    text-align: center;
    margin-bottom: 20px;
    border-bottom: 1px solid #eee;
    padding-bottom: 10px;
}

header h1 {
    margin: 0;
    color: #333;
}

header p {
    margin: 5px 0;
    color: #555;
}

section {
    margin-bottom: 20px;
}

section h2 {
    color: #555;
    border-bottom: 2px solid #eee;
    padding-bottom: 5px;
    margin-bottom: 10px;
}

.contact-info p, .summary p, .experience ul li, .education p, .skills ul li {
    margin-bottom: 10px;
}

.experience h3, .education h3 {
    margin-bottom: 5px;
    color: #444;
}

.experience p, .education p {
    font-style: italic;
    color: #666;
}

a {
    color: #007bff;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}
